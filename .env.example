# Firebase Configuration
# Get these values from your Firebase Console: https://console.firebase.google.com/
# Project Settings > General > Your apps > Web app configuration

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Firebase App Check — reCAPTCHA v3 site key
# Create at https://console.cloud.google.com/security/recaptcha (or via
# Firebase console > App Check > register app with reCAPTCHA v3).
# Leave empty to disable App Check locally.
VITE_RECAPTCHA_SITE_KEY=

# Optional: Application Configuration
# VITE_APP_NAME=Inkuthazo
# VITE_APP_ENV=development
