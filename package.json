{
  "name": "social-club-portal",
  "private": true,
  "version": "3.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "VITE_USE_EMULATORS=true vite",
    "emulators": "firebase emulators:start --import=./.emulator-data --export-on-exit=./.emulator-data",
    "seed:emulator": "FIRESTORE_EMULATOR_HOST=127.0.0.1:8080 tsx scripts/seedEmulator.ts",
    "build": "tsc && vite build",
    "vercel-build": "rm -rf dist node_modules/.vite && tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore --project demo-inkuthazo-rules \"vitest run --config vitest.rules.config.ts\""
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.15",
    "@fullcalendar/daygrid": "^6.1.15",
    "@fullcalendar/interaction": "^6.1.15",
    "@fullcalendar/react": "^6.1.15",
    "@fullcalendar/timegrid": "^6.1.15",
    "@headlessui/react": "^2.2.0",
    "@nivo/bar": "^0.90.0",
    "@nivo/calendar": "^0.90.0",
    "@nivo/core": "^0.90.0",
    "@nivo/line": "^0.90.0",
    "@nivo/pie": "^0.90.0",
    "@nivo/radar": "^0.90.0",
    "@tanstack/react-query": "^5.101.2",
    "date-fns": "^4.1.0",
    "firebase": "^11.0.2",
    "html2canvas": "^1.4.1",
    "html5-qrcode": "^2.3.8",
    "ics": "^3.8.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.1.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@tailwindcss/forms": "^0.5.9",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.2",
    "@typescript-eslint/eslint-plugin": "^8.18.2",
    "@typescript-eslint/parser": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "firebase-tools": "^15.24.0",
    "globals": "^15.13.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.2",
    "vite": "^6.2.1",
    "vitest": "^4.1.10"
  },
  "optionalDependencies": {
    "@rollup/rollup-darwin-arm64": "^4.60.1"
  }
}
